<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="017-add-user-id-to-cart-items" author="homebase_db">
        <addColumn tableName="cart_items" schemaName="homebase_db">
            <column name="user_id" type="VARCHAR(255)"/>
        </addColumn>
        <createIndex tableName="cart_items" schemaName="homebase_db" indexName="idx_cart_items_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="017-add-cart-reminder-to-users" author="homebase_db">
        <addColumn tableName="users" schemaName="homebase_db">
            <column name="last_cart_reminder_sent" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
