<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="014-create-coupons-table" author="homebase_db">
        <createTable tableName="coupons" schemaName="homebase_db">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(30)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="discount_value" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="min_order_amount" type="BIGINT"/>
            <column name="max_discount" type="BIGINT"/>
            <column name="usage_limit" type="INT"/>
            <column name="used_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="valid_from" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="valid_to" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_time" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="014-create-coupon-usages-table" author="homebase_db">
        <createTable tableName="coupon_usages" schemaName="homebase_db">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="coupon_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="order_id" type="VARCHAR(255)"/>
            <column name="used_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="coupon_usages" schemaName="homebase_db"
                             columnNames="coupon_id, user_id"
                             constraintName="uk_coupon_usage_user"/>
    </changeSet>

    <changeSet id="014-add-discount-to-orders" author="homebase_db">
        <addColumn tableName="orders" schemaName="homebase_db">
            <column name="discount_amount" type="BIGINT" defaultValueNumeric="0"/>
            <column name="coupon_code" type="VARCHAR(30)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
